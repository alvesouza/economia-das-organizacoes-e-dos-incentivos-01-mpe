{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(graphify:*)",
      "Bash(sg:*)",
      "Bash(rg:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python tools/*.py:*)",
      "Bash(python .claude/quiz-validate.py:*)",
      "Bash(python -m http.server:*)",
      "Bash(markitdown:*)",
      "Bash(pdflatex:*)",
      "Bash(pdffonts:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "Bash(qpdf:*)",
      "Bash(beatcheck:*)",
      "Bash(explainer-compile:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm test:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(docker compose up:*)",
      "Bash(docker build:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(cargo add:*)",
      "Bash(dotnet add:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/secrets/**)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/target/**)",
      "Read(**/.venv/**)",
      "Read(**/graphify-out/cache/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)"
    ]
  },

  "env": {
    "AGENT_NOTES_DIR": ".agent/notes",
    "AGENT_PLANS_DIR": ".agent/plans",
    "GRAPH_PATH": "graphify-out/graph.json"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_context.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_generated.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
